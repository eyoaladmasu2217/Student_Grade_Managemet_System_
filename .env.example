# Copy to .env and adjust values before running the API.
# Never commit real credentials or production origins.

SGMS_ENV=development
SGMS_DATABASE_PATH=backend/data/gradebook.sqlite3
SGMS_COOKIE_SECURE=true
SGMS_ALLOW_INSECURE_COOKIES=false
SGMS_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
